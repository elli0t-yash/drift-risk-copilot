              "mode": "raw",
              "raw": "{\n  \"portfolio\": {{portfolio}},\n  \"experiment\": {\n    \"type\": \"CvarRebalance\",\n    \"confidence_level\": 0.99,\n    \"per_name_cap\": 0.20,\n    \"turnover_limit\": 0.30,\n    \"commission_bps\": 10\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {"raw": "{{base_url}}/experiment", "host": ["{{base_url}}"], "path": ["experiment"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('trace records a smaller tail_scenario_count at higher confidence', () => {",
                  "    const out = pm.response.json().outputs.result;",
                  "    console.log('tail_scenario_count at 0.99:', out.tail_scenario_count, '/', out.scenario_count);",
                  "    pm.expect(out.tail_scenario_count).to.be.a('number');",
                  "    pm.expect(out.tail_scenario_count).to.be.below(out.scenario_count);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}

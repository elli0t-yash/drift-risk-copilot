    {
      "name": "2. Experiment - direct",
      "item": [
        {
          "name": "a. FactorShock - Nifty -12% Brent +20%",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"portfolio\": {{portfolio}},\n  \"experiment\": {\n    \"type\": \"FactorShock\",\n    \"shocks_pct\": {\"MARKET\": -12.0, \"BRENT\": 20.0},\n    \"propagate\": true\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {"raw": "{{base_url}}/experiment", "host": ["{{base_url}}"], "path": ["experiment"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// NOTE: the checkpoint brief assumed the body field is \"shocks\" and the",
                  "// values are decimal fractions (-0.12). The deployed API's real field is",
                  "// \"shocks_pct\", taking simple PERCENT values (-12.0 for -12%) -- see",
                  "// compute::experiments::FactorShockInput.shocks_pct.",
                  "//",
                  "// The brief also assumed portfolio_pnl_inr/implied_shocks live at the top",
                  "// of `outputs`. The real trace wraps FactorShock's payload one level",
                  "// deeper, at outputs.result (with an outputs.note string alongside it).",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('outputs.result.portfolio_pnl_inr present and < 0', () => {",
                  "    const out = pm.response.json().outputs.result;",
                  "    pm.expect(out.portfolio_pnl_inr).to.exist;",
                  "    pm.expect(out.portfolio_pnl_inr).to.be.below(0);",
                  "});",
                  "pm.test('outputs.result.implied_shocks.USDINR present', () => {",
                  "    const out = pm.response.json().outputs.result;",
                  "    pm.expect(out.implied_shocks).to.have.property('USDINR');",
                  "});",
                  "pm.test('both invariants passed', () => {",
                  "    const invariants = pm.response.json().invariants;",
                  "    pm.expect(invariants.every(i => i.passed)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "b. RiskDecomposition",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"portfolio\": {{portfolio}},\n  \"experiment\": {\n    \"type\": \"RiskDecomposition\"\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {"raw": "{{base_url}}/experiment", "host": ["{{base_url}}"], "path": ["experiment"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// NOTE: brief assumed \"portfolio_vol_annualised\" (British spelling) and",
                  "// per-check boolean fields \"euler_stock_sum_check\"/\"euler_factor_sum_check\".",
                  "// The real field is \"portfolio_vol_annualized\" (American spelling), flat at",
                  "// outputs.* (no outputs.result wrapper here, unlike FactorShock/CvarRebalance",
                  "// -- this inconsistency is itself worth knowing about). The Euler-sum checks",
                  "// are plain entries in the top-level `invariants` array, not named boolean",
                  "// fields; matched here by their actual invariant `name` text.",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('outputs.portfolio_vol_annualized present and > 0', () => {",
                  "    const out = pm.response.json().outputs;",
                  "    pm.expect(out.portfolio_vol_annualized).to.exist;",
                  "    pm.expect(out.portfolio_vol_annualized).to.be.above(0);",
                  "});",
                  "pm.test('by-stock Euler sum invariant passed', () => {",
                  "    const invariants = pm.response.json().invariants;",
                  "    const inv = invariants.find(i => i.name.includes('by_stock.contribution'));",
                  "    pm.expect(inv, 'invariant not found').to.exist;",
                  "    pm.expect(inv.passed).to.be.true;",
                  "});",
                  "pm.test('by-factor Euler sum invariant passed', () => {",
                  "    const invariants = pm.response.json().invariants;",
                  "    const inv = invariants.find(i => i.name.includes('by_factor.contribution'));",
                  "    pm.expect(inv, 'invariant not found').to.exist;",
                  "    pm.expect(inv.passed).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "c. CvarRebalance",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"portfolio\": {{portfolio}},\n  \"experiment\": {\n    \"type\": \"CvarRebalance\",\n    \"confidence_level\": 0.95,\n    \"per_name_cap\": 0.20,\n    \"turnover_limit\": 0.30,\n    \"commission_bps\": 10\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {"raw": "{{base_url}}/experiment", "host": ["{{base_url}}"], "path": ["experiment"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// NOTE: brief assumed the input field is \"confidence\" -- the real field is",
                  "// \"confidence_level\" (compute::cvar::CvarRebalanceInput.confidence_level).",
                  "// Also wrapped at outputs.result like FactorShock. The named boolean checks",
                  "// \"lp_objective_matches_cvar_check\"/\"weights_sum_check\" don't exist as fields;",
                  "// they're entries in `invariants`, matched here by their real name text.",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('stats_after.historical_cvar < stats_before.historical_cvar', () => {",
                  "    const out = pm.response.json().outputs.result;",
                  "    pm.expect(out.stats_after.historical_cvar).to.be.below(out.stats_before.historical_cvar);",
                  "});",
                  "pm.test('LP objective matches directly-computed CVaR', () => {",
                  "    const invariants = pm.response.json().invariants;",
                  "    const inv = invariants.find(i => i.name.includes('LP objective'));",
                  "    pm.expect(inv, 'invariant not found').to.exist;",
                  "    pm.expect(inv.passed).to.be.true;",
                  "});",
                  "pm.test('weights sum to 1', () => {",
                  "    const invariants = pm.response.json().invariants;",
                  "    const inv = invariants.find(i => i.name.includes('sum(weights_after)'));",
                  "    pm.expect(inv, 'invariant not found').to.exist;",
                  "    pm.expect(inv.passed).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "d. FactorShock - all 5 factors given, propagate true",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"portfolio\": {{portfolio}},\n  \"experiment\": {\n    \"type\": \"FactorShock\",\n    \"shocks_pct\": {\n      \"MARKET\": -5.0,\n      \"USDINR\": 2.0,\n      \"BRENT\": 10.0,\n      \"GOLD_USD\": -3.0,\n      \"RATES_PROXY\": 1.0\n    },\n    \"propagate\": true\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {"raw": "{{base_url}}/experiment", "host": ["{{base_url}}"], "path": ["experiment"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// NOTE: the brief's GOLD factor is named GOLD_USD in the real API (renamed",
                  "// in a later checkpoint to make clear it's USD-denominated gold).",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('conditional propagation is a no-op when all 5 factors are given', () => {",
                  "    const out = pm.response.json().outputs.result;",
                  "    pm.expect(Object.keys(out.implied_shocks).length).to.eql(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "e. CvarRebalance - tau = 0",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"portfolio\": {{portfolio}},\n  \"experiment\": {\n    \"type\": \"CvarRebalance\",\n    \"confidence_level\": 0.95,\n    \"per_name_cap\": 0.20,\n    \"turnover_limit\": 0.0,\n    \"commission_bps\": 10\n  }\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {"raw": "{{base_url}}/experiment", "host": ["{{base_url}}"], "path": ["experiment"]}
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// NOTE: brief assumed \"before_weights\"/\"after_weights\" -- the real fields",
                  "// are \"weights_before\"/\"weights_after\" (compute::cvar::CvarRebalanceOutput).",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('every weight unchanged within 0.001 (tau=0)', () => {",
                  "    const out = pm.response.json().outputs.result;",
                  "    for (const ticker of Object.keys(out.weights_before)) {",
                  "        const before = out.weights_before[ticker];",
                  "        const after = out.weights_after[ticker];",
                  "        pm.expect(Math.abs(after - before), `${ticker}: ${after} vs ${before}`).to.be.below(0.001);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
